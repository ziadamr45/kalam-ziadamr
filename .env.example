# =====================================================================
# متغيرات البيئة — منصة «كلام له لازمة» العامة
# انسخ هذا الملف إلى .env.local محليًا، وأدخل القيم في Vercel عند النشر
# =====================================================================

# ---------- قاعدة البيانات PostgreSQL ----------
# يوصى بـ Neon أو Supabase أو Vercel Postgres (إنتاج) — نفس القيمة في لوحة التحكم
DATABASE_URL="postgresql://user:password@host:5432/kalam?schema=public&sslmode=require"

# ---------- مصادقة Google (Auth.js v5) ----------
# الدليل الكامل لاستخراجها: ملف GOOGLE_OAUTH_GUIDE.md في جذر هذا المستودع
# ⚠️ إعداد إلزامي في Vercel (Production) لكلا المشروعين دون شرطة مائلة نهائية:
#    NEXTAUTH_URL = https://adamr.vercel.app
#    AUTH_URL     = https://adamr.vercel.app
#    NEXTAUTH_SECRET = AUTH_SECRET = (قيمة موحدة قوية — openssl rand -base64 32)
#    مطابقة النطاق هنا هي ما يقضي على الشاشة الرمادية
#    «There is a problem with the server configuration» بعد العودة من Google.
# ⚠️ تنبيه هندسي (تم التحقق ليلًا): adamr.vercel.app يعيد 404 حاليًا —
#    أي أنه غير مربوط بمشروع Vercel. أضِفه من Project Settings → Domains أولًا،
#    وإلا فاضبط القيمة على النطاق الفعلي الخادم للموقع (kalam-ziadamr.vercel.app).
#    ملاحظة: trustHost: true + secret الصريح في auth.ts يجعلان المصادقة تعمل
#    باستنتاج النطاق من الطلب حتى لو اختلفت القيمة مؤقتًا.
NEXTAUTH_URL="https://adamr.vercel.app"
AUTH_URL="https://adamr.vercel.app"
NEXTAUTH_SECRET="ضع هنا سلسلة عشوائية قوية — ولّدها بـ: openssl rand -base64 32"
AUTH_SECRET="نفس قيمة NEXTAUTH_SECRET بالضبط"
GOOGLE_CLIENT_ID="ضع هنا Google Client ID"
GOOGLE_CLIENT_SECRET="ضع هنا Google Client Secret"

# ---------- هوية الموقع ----------
NEXT_PUBLIC_SITE_URL="https://kalam-ziadamr.vercel.app"
NEXT_PUBLIC_SITE_NAME="كلام له لازمة"

# ---------- إعادة التحقق الفوري (On-Demand ISR) ----------
# سر مشترك تستدعيه لوحة التحكم لإعادة توليد صفحات المقال لحظة النشر
# ولّده بـ: openssl rand -hex 32  (نفس القيمة في لوحة التحكم)
REVALIDATE_SECRET="ضع هنا سر إعادة التحقق"
